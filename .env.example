# Public application origin
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (required for accounts and persistent user sessions)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI (required for new transcription and semantic/video analysis)
OPENAI_API_KEY=

# Inngest (required for durable deployed processing; local dev server can supply these)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Protects the daily Vercel media/guest retention task (24+ random characters)
CRON_SECRET=

# Optional sanitized error monitoring
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
